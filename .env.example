# OmniSearch AI Gateway
OMNI_AI_PROVIDER=local_command
OMNI_AI_TIMEOUT_SECONDS=180
OMNI_AI_PROTOCOL=oneshot

# Local BitNet llama-server or a compatible endpoint
OMNI_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OMNI_OPENAI_MODEL=bitnet
OMNI_OPENAI_API_KEY=

# Hosted endpoint example: HTTPS only, key stays in backend environment
# OMNI_OPENAI_BASE_URL=https://provider.example/v1
# OMNI_OPENAI_MODEL=your-model-id
# OMNI_OPENAI_API_KEY=put-a-real-secret-in-your-private-backend-environment

# Local-to-remote fallback is OFF unless both are explicitly enabled
OMNI_AI_FALLBACK=
OMNI_REMOTE_FALLBACK_CONSENT=false

# Optional retrieval key, backend only
OMNI_FIRECRAWL_API_KEY=
